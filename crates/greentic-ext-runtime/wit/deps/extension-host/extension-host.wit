package greentic:extension-host@0.1.0;

interface logging {
  enum level {
    trace,
    debug,
    info,
    warn,
    error,
  }
  log: func(level: level, target: string, message: string);
  log-kv: func(level: level, target: string, message: string,
               fields: list<tuple<string, string>>);
}

interface i18n {
  t: func(key: string) -> string;
  tf: func(key: string, args: list<tuple<string, string>>) -> string;
}

interface secrets {
  get: func(uri: string) -> result<string, string>;
}

interface broker {
  call-extension: func(
    kind: string,
    target-id: string,
    function: string,
    args-json: string
  ) -> result<string, string>;
}

interface http {
  record request {
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
  }
  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }
  fetch: func(req: request) -> result<response, string>;
}

/// Host interface for invoking tenant-configured LLM providers.
interface llm {
  record llm-message {
    /// Message role: "system", "user", or "assistant".
    role: string,
    content: string,
  }
  variant response-format {
    text,
    json,
    /// Constrain output to a serialized JSON Schema document.
    json-schema(string),
  }
  record llm-request {
    /// LLM role wire name as declared in the extension's
    /// `describe.runtime.permissions.llmRoles` list. Pass `none` when the
    /// extension declares exactly one role (the host selects it); required
    /// when multiple roles are declared. Roles outside the declared list
    /// are rejected.
    role-hint: option<string>,
    system-prompt: string,
    messages: list<llm-message>,
    response-format: option<response-format>,
  }
  record llm-response {
    content: string,
    total-tokens: option<u32>,
  }
  complete: func(request: llm-request) -> result<llm-response, string>;

  record embed-request {
    /// Same rule as `llm-request.role-hint`: a role the extension declared in
    /// `describe.runtime.permissions.llmRoles`. Pass `none` when exactly one
    /// role is declared.
    role-hint: option<string>,
    /// Texts to embed. The host caps both the count and the total size and
    /// refuses an over-cap batch rather than truncating it.
    inputs: list<string>,
  }
  record embed-response {
    /// One vector per input, in input order.
    vectors: list<list<f32>>,
    /// The model the host actually used. Key your vector store on this —
    /// vectors from two models are not comparable, so an index built under a
    /// model the host has since moved off will silently lose recall.
    model: string,
  }
  embed: func(request: embed-request) -> result<embed-response, string>;
}

/// Host interface for storing a file the extension produced (an image, a PDF,
/// a CSV, ...). The host stores the bytes under the caller's tenant and returns
/// an opaque `artifact://` id that the extension puts in its tool result.
/// Bytes never travel in a tool result: `invoke-tool` returns a string.
interface artifact {
  variant artifact-error {
    /// This host does not wire an artifact store.
    unsupported,
    /// The call carried no tenant; nothing is stored without one.
    tenant-required,
    /// Over the per-file cap (10 MiB) or empty.
    invalid-size,
    /// `name` or `mime-type` failed validation (blank, control chars, path
    /// separators, too long).
    invalid-input(string),
    /// The store refused the media type (not on the host's allow-list).
    unsupported-media-type,
    /// The tenant's byte quota is exhausted.
    quota-exceeded,
    /// The store is unreachable or failed. Detail is logged host-side, never
    /// returned: it can name internal hosts.
    unavailable,
  }
  /// Store `bytes` and return the `artifact://` id.
  put: func(bytes: list<u8>, mime-type: string, name: string) -> result<string, artifact-error>;
}

/// Host interface for writing to the caller's knowledge library: create a
/// text document in a knowledge base, read one back, list a base's documents,
/// and remove one from a base. The host decides the tenant, the team and which
/// bases the call may touch; a guest only ever names a base by the name an
/// operator sees. Each operation must also be declared by the extension as a
/// `knowledge://<op>` token in `runtime.permissions.network`.
interface knowledge {
  /// Closed set of failures. None of them carries document text.
  variant knowledge-error {
    /// The operation is not declared by the extension, the call carried no
    /// tenant, or the base is not one this call may use. An unknown base reads
    /// exactly like a forbidden one.
    not-allowed,
    /// No such document in that base.
    not-found,
    /// The text or the name is over the host's cap.
    too-large,
    /// The host refused the content (not UTF-8 text, markdown, CSV or JSON).
    invalid-media-type,
    /// The tenant's knowledge quota is exhausted.
    quota-exceeded,
    /// The host has no knowledge store, or it failed. Detail is logged
    /// host-side, never returned.
    unavailable,
  }

  record created {
    document-id: string,
    /// False when an identical document already existed and was reused.
    created: bool,
  }

  record document {
    name: string,
    text: string,
    /// True when the host returned only a prefix of the text.
    truncated: bool,
  }

  record document-info {
    document-id: string,
    name: string,
    size-chars: u64,
  }

  /// Create a document from `text` in the base named `knowledge-base`.
  create: func(knowledge-base: string, name: string, text: string) -> result<created, knowledge-error>;
  /// Read one document of the base.
  read: func(knowledge-base: string, document-id: string) -> result<document, knowledge-error>;
  /// List the documents of the base.
  %list: func(knowledge-base: string) -> result<list<document-info>, knowledge-error>;
  /// Remove a document from the base. The library document itself is kept.
  /// Returns false when it was not a member.
  remove: func(knowledge-base: string, document-id: string) -> result<bool, knowledge-error>;
}

world extension-host-world {
  import logging;
  import i18n;
  import secrets;
  import broker;
  import http;
  import llm;
  import artifact;
  import knowledge;
}
